# Copy to .env.local for development. Set the same values in the AWS Amplify
# console (App settings > Environment variables) for each deployed branch.
#
# Server-only vars (no NEXT_PUBLIC_ prefix) must ALSO be listed in the `env`
# block of next.config.js, or Amplify's Lambda compute will see them as
# undefined. NEXT_PUBLIC_ vars are inlined by Next.js automatically.

# --- Site ---------------------------------------------------------------
# Canonical site URL, no trailing slash. Used for metadata, sitemap, robots and
# the event_source_url sent to the Conversions API.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Lead routing -------------------------------------------------------
# Where the call back form posts. The CRM tags the contact with its source and
# campaign on arrival. Leave unset locally: leads are logged to the console
# instead, and nothing is written to the live list.
CRM_WEBHOOK_URL=
# Optional bearer token sent with the webhook.
CRM_WEBHOOK_TOKEN=

# --- Meta tracking ------------------------------------------------------
# Pixel ID. The pixel is not loaded at all when this is unset, so previews never
# pollute campaign data. Set BOTH of these to the same pixel: the public one
# loads the browser pixel, the server one is used by the Conversions API.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
# Conversions API access token. Without it the server half of each Lead event is
# skipped and only the browser event is counted.
META_CAPI_ACCESS_TOKEN=
# Optional. Events Manager test event code, for verifying deduplication.
META_CAPI_TEST_CODE=

# --- Google Analytics ---------------------------------------------------
# GA4 measurement ID. Leave unset to disable analytics entirely.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
